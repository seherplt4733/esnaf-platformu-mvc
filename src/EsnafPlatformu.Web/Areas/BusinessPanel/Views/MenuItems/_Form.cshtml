@model EsnafPlatformu.Web.ViewModels.MenuItemFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Price" class="form-label"></label>
    <input asp-for="Price" type="text" inputmode="decimal"
           class="form-control" placeholder="280,50" />
    <span asp-validation-for="Price" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="SortOrder" class="form-label"></label>
    <input asp-for="SortOrder" class="form-control" min="0" />
    <span asp-validation-for="SortOrder" class="text-danger"></span>
</div>

<div class="form-check mb-3">
    <input asp-for="IsVisible" class="form-check-input" />
    <label asp-for="IsVisible" class="form-check-label"></label>
    <span asp-validation-for="IsVisible" class="text-danger"></span>
</div>

<div class="d-flex flex-wrap gap-2">
    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a asp-area="BusinessPanel"
       asp-controller="MenuItems"
       asp-action="Index"
       class="btn btn-outline-secondary">Menüye dön</a>
</div>