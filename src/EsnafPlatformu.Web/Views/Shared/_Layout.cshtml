<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Esnaf Platformu</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/EsnafPlatformu.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-md" aria-label="Ana menü">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home"
                   asp-action="Index">kutvify</a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false"
                        aria-label="Ana menüyü aç veya kapat">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div id="mainNavbar" class="collapse navbar-collapse">
                    <ul class="navbar-nav mx-auto gap-md-3">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home"
                               asp-action="Index">Anasayfa</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home"
                               asp-action="Index" asp-fragment="ozellikler">Özellikler</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home"
                               asp-action="Index" asp-fragment="tasarimlar">Tasarımlar</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home"
                               asp-action="Index" asp-fragment="nasil-calisir">Nasıl çalışır?</a>
                        </li>
                    </ul>

                    <div class="d-flex flex-wrap align-items-center gap-2 py-2 py-md-0">
                    <partial name="~/Views/Shared/_LoginPartial.cshtml" />

              <a class="home-cta" asp-area="" asp-controller="Home"
       asp-action="Index" asp-fragment="nasil-calisir">Ücretsiz başla</a>
               </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        @if (ViewContext.RouteData.Values["area"]?.ToString() == "BusinessPanel"
    && User.Identity?.IsAuthenticated == true)
{
    <nav class="border-bottom py-2 mb-3" aria-label="İşletme paneli">
        <ul class="nav flex-wrap">
            <li class="nav-item">
                <a class="nav-link" asp-area="BusinessPanel"
                   asp-controller="Businesses" asp-action="Edit">
                    İşletme
                </a>
            </li>

                <li class="nav-item">
               <a class="nav-link" asp-area="BusinessPanel"
            asp-controller="Stores" asp-action="Index">
               Mağazalar
               </a>
                 </li>

            <li class="nav-item">
                <a class="nav-link" asp-area="BusinessPanel"
                   asp-controller="MenuItems" asp-action="Index">
                    Menü
                </a>
            </li>
            <li class="nav-item">
                <span class="nav-link disabled" aria-disabled="true">Görünüm</span>
            </li>
            <li class="nav-item">
                <span class="nav-link disabled" aria-disabled="true">Yayın</span>
            </li>
        </ul>
    </nav>
}

        
        <main class="pb-3">


            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 Esnaf Platformu ·
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Gizlilik</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>